# Copy to .env (it is gitignored). Both values are optional:
# with no server address the app runs in demo mode with sample summaries.
# You can also type these into the app under Connection instead, which keeps
# the passcode out of the built APK.

# Full address of your server's summarize route, e.g. https://yt.example.com/summarize
EXPO_PUBLIC_SERVER_URL=

# Must match APP_PASSCODE on the server. Anything EXPO_PUBLIC_ is readable inside the APK.
EXPO_PUBLIC_APP_PASSCODE=
