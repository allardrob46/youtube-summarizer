# Copy to server/.env (never commit it) or point systemd's EnvironmentFile at it.

# Required. A long random string; the app sends it in the x-app-passcode header.
# Make one with:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
APP_PASSCODE=

# Required. From https://console.groq.com/keys
GROQ_API_KEY=

# Optional. openai/gpt-oss-120b is on Groq's self-serve plan and supports strict JSON output.
# llama-3.3-70b-versatile works too if your Groq account has access to it.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

# Optional. Where the server listens. Keep 127.0.0.1 when Caddy sits in front.
HOST=127.0.0.1
PORT=8787

# Optional. Transcript part size for long videos (characters, about 4 per token).
CHUNK_CHARS=24000

# Optional. Total summaries allowed per hour (protects your Groq bill).
MAX_PER_HOUR=60

# Optional. Preferred caption languages, in order.
TRANSCRIPT_LANGS=en

# Optional. If YouTube blocks your server's IP, route caption requests through a
# residential proxy, e.g. http://user:pass@proxy.example.com:8080
YT_PROXY_URL=
